  m_Name: 
  m_EditorClassIdentifier: 
  zones:
  - name: Threshold Glade
    spawn: {x: 0, y: -33.9, z: -158}
    yaw: 0
    hint: Space jumps; hold it to hover in Dream. Press Q to shift the
      world, then shoot the glowing bud (left-click) to open the thorns.
  - name: The Hollow Bridge
    spawn: {x: 0, y: -33.9, z: -129}
    yaw: 0
    hint: Petals only hold in Dream. Thorns only hold in Nightmare. Press Q
      in the air to land on the other world. Shift dashes across long gaps.
  - name: The Weeping Wall
    spawn: {x: 0, y: -30.7, z: -62}
    yaw: 0
    hint: 'Jump at a wall with glowing handholds to run along it; Space leaps
      off. Handholds exist in one world: press Q mid-run when they change.'
  - name: The Gloam Hollow
    spawn: {x: 0, y: -26.9, z: 7.5}
    yaw: 0
    hint: 'Moths: in Dream, hold right-click near them to absorb them. Crawlers charge
      along the line they show. Watchers can only be hurt in Nightmare.'
  - name: Rootclimb
    spawn: {x: 0, y: -25.5, z: 38.6}
    yaw: 0
    hint: 'Climb the roots. Blossoms throw you upward in Dream. In Nightmare the
      gloom rises from below: do not linger.'
  - name: The Sleeper's Approach
    spawn: {x: 0, y: -3.1, z: 68}
    yaw: 0
    hint: Rest at the well. The Sleeper waits beneath the great tree.
  - name: The Sleeper
    spawn: {x: 0, y: 0.15, z: 108.5}
    yaw: 0
    hint: Step into the clearing to wake the Sleeper.
  player: {fileID: 2120866943}
  killDepth: 14
  fallCost: 0.05
  firstSwapSpeed: 0.5
